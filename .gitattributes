# Byte-exact artifacts.  These files are digest-pinned in source and verified
# with sha256 over their raw bytes, so end-of-line translation on checkout
# makes the runtime fail closed on the checked-out working tree.  Keep their
# bytes identical on every platform.
hass_mcp_engineering_beta/ha_mcp_engineering/dependency/template_semantic_registry.json -text
scripts/template_semantic_registry_source.json -text
docs/evidence/home-assistant-template-source-blobs.json -text
# HAMCP-162 D1 evidence: fixtures and captures are hashed in MANIFEST.sha256 and
# in the capture records, and some fixtures are deliberately CRLF, BOM, latin-1
# or binary.
docs/evidence/hamcp162/** -text
docs/evidence/hamcp162/fixtures/variants/crlf.yaml.fixture -whitespace
# HAMCP-222: verbatim upstream Core diff, hash-bound by diff_artifacts_sha256 in
# docs/evidence/hamcp222/inputs/evidence-add-2026.10.3.json; its blank context
# lines are a single space and must stay byte-exact.
docs/evidence/hamcp222/artifacts-2026.10.3/diff/flagged-diffs.patch -text -whitespace
# HAMCP-224: journal export streams carry binary-length fields and are
# SHA-256 pinned in provenance.json; journal files are gzip binaries.
tests/fixtures/hamcp224_journal/*.export -text -whitespace
tests/fixtures/hamcp224_journal/*.gz binary
