+def _without_loopback_port(uri: str) -> str | None:
+    """Remove only the port from an HTTP loopback redirect URI."""
+    try:
+        parts = urlparse(uri)
+        port = parts.port
+    except ValueError:
+        return None
+
+    if (
+        parts.scheme != "http"
+        or parts.hostname not in ("127.0.0.1", "::1", "localhost")
+        or parts.username is not None
+        or "#" in uri
+        or port == 0
