# HAMCP-162 D1 synthetic configuration. Every credential below is synthetic.
homeassistant:
  name: Synthetic D1
  unit_system: metric
  packages: !include_dir_named packages
  customize:
    sensor.synthetic_temperature:
      friendly_name: Synthetic temperature
      icon: mdi:thermometer
  auth_providers:
    - type: homeassistant
recorder:
