{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeter-1/hass-mcp-admin/promotion/manifest_schema.json",
  "title": "HA MCP Engineering promotion regression manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "target", "observations", "sentinels"],
  "properties": {
    "manifest_version": {"const": 2},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "tag", "build_sha", "evidence_captured_at", "evidence_source"],
      "properties": {
        "release": {"type": "string", "minLength": 1, "maxLength": 64},
        "tag": {"type": "string", "minLength": 1, "maxLength": 80},
        "build_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "evidence_captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "evidence_source": {"type": "string", "minLength": 20, "maxLength": 2000},
        "notes": {"type": "string", "maxLength": 2000}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/observation"}
    },
    "sentinels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {"$ref": "#/$defs/sentinel"}
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool", "arguments", "effect_class", "procedure"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$", "maxLength": 80},
        "tool": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 128},
        "arguments": {"type": "object", "maxProperties": 20},
        "operator_arguments": {
          "type": "object",
          "maxProperties": 10,
          "additionalProperties": {"type": "object"}
        },
        "effect_class": {"const": "read_only"},
        "procedure": {"type": "string", "minLength": 20, "maxLength": 2000},
        "target_binding": {"enum": ["fixed", "operator_local"]},
        "target_note": {"type": "string", "minLength": 20, "maxLength": 1200}
      },
      "allOf": [
        {
          "if": {
            "properties": {"target_binding": {"const": "operator_local"}},
            "required": ["target_binding"]
          },
          "then": {"required": ["operator_arguments", "target_note"]}
        }
      ]
    },
    "sentinel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "description", "register_section", "observation",
        "expected_status", "desired_checks"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 100},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": "string", "minLength": 20, "maxLength": 2000},
        "register_section": {"enum": ["minimum_permanent_sentinels", "confirmed_regression_passes"]},
        "observation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
        "expected_status": {"enum": ["expected_pass", "expected_fail"]},
        "desired_checks": {
          "type": "array", "minItems": 1, "maxItems": 40,
          "items": {"$ref": "#/$defs/check"}
        },
        "known_failure_checks": {
          "type": "array", "minItems": 1, "maxItems": 40,
          "items": {"$ref": "#/$defs/check"}
        },
        "deficiency": {"$ref": "#/$defs/deficiency"}
      },
      "allOf": [
        {
          "if": {"properties": {"expected_status": {"const": "expected_fail"}}, "required": ["expected_status"]},
          "then": {"required": ["deficiency", "known_failure_checks"]}
        },
        {
          "if": {"properties": {"expected_status": {"const": "expected_pass"}}, "required": ["expected_status"]},
          "then": {
            "not": {"anyOf": [{"required": ["deficiency"]}, {"required": ["known_failure_checks"]}]}
          }
        }
      ]
    },
    "deficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register_item", "summary", "observed_evidence"],
      "properties": {
        "register_item": {"type": "integer", "minimum": 1},
        "related_register_items": {
          "type": "array", "maxItems": 8,
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true
        },
        "summary": {"type": "string", "minLength": 10, "maxLength": 1000},
        "observed_evidence": {"type": "string", "minLength": 10, "maxLength": 1600}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 240},
        "operator": {
          "enum": [
            "equals", "not_equals", "one_of", "gte", "lte", "gt", "lt",
            "present", "absent", "matches", "equals_observation_path",
            "equals_invocation_argument"
          ]
        },
        "value": {},
        "values": {"type": "array", "minItems": 1, "maxItems": 30},
        "source_observation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
        "observation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
        "reference_path": {"type": "string", "minLength": 1, "maxLength": 240},
        "invocation_argument": {"type": "string", "minLength": 1, "maxLength": 120},
        "note": {"type": "string", "maxLength": 1000}
      },
      "allOf": [
        {
          "if": {"properties": {"operator": {"enum": ["equals", "not_equals", "gte", "lte", "gt", "lt", "matches"]}}, "required": ["operator"]},
          "then": {"required": ["value"]}
        },
        {
          "if": {"properties": {"operator": {"const": "one_of"}}, "required": ["operator"]},
          "then": {"required": ["values"]}
        },
        {
          "if": {"properties": {"operator": {"const": "equals_observation_path"}}, "required": ["operator"]},
          "then": {"required": ["observation", "reference_path"]}
        },
        {
          "if": {"properties": {"operator": {"const": "equals_invocation_argument"}}, "required": ["operator"]},
          "then": {"required": ["invocation_argument"]}
        }
      ]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_schema_version", "manifest_version", "manifest_digest",
        "captured_at", "captured_by", "session_id", "target", "observations"
      ],
      "properties": {
        "_fixture_provenance": {"type": "object", "maxProperties": 12},
        "capture_schema_version": {"const": 1},
        "manifest_version": {"type": "integer", "minimum": 1},
        "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "captured_at": {"type": "string", "minLength": 20, "maxLength": 40},
        "captured_by": {"type": "string", "minLength": 1, "maxLength": 160},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release", "build_sha"],
          "properties": {
            "release": {"type": "string", "minLength": 1, "maxLength": 64},
            "build_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "observations": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_]*$"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "tool", "arguments", "status"],
            "properties": {
              "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
              "tool": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 128},
              "arguments": {"type": "object", "maxProperties": 20},
              "status": {"enum": ["captured", "not_captured"]},
              "evidence": {
                "type": "object", "maxProperties": 128,
                "propertyNames": {"minLength": 1, "maxLength": 240}
              },
              "absent_paths": {
                "type": "array", "maxItems": 128, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 240}
              },
              "not_recorded_reason": {"type": "string", "minLength": 3, "maxLength": 500}
            },
            "allOf": [
              {
                "if": {"properties": {"status": {"const": "captured"}}, "required": ["status"]},
                "then": {
                  "required": ["evidence", "absent_paths"],
                  "not": {"required": ["not_recorded_reason"]}
                }
              },
              {
                "if": {"properties": {"status": {"const": "not_captured"}}, "required": ["status"]},
                "then": {
                  "required": ["not_recorded_reason"],
                  "not": {"anyOf": [{"required": ["evidence"]}, {"required": ["absent_paths"]}]}
                }
              }
            ]
          }
        }
      }
    }
  }
}
